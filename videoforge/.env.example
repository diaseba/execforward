# Copia a .env y completa. Todas las claves son de tiers GRATUITOS.

# Footage de stock libre (motor "stock"). Crea key gratis en pexels.com/api
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Voz TTS de alta calidad con Piper (opcional): ruta a un modelo .onnx
# Descarga voces en https://github.com/rhasspy/piper/releases
PIPER_VOICE=
